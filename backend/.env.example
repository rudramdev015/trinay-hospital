# ── TRINAY HOSPITAL BACKEND — Environment Variables ──────────────────────────
# Copy this file to .env for local development
# On Render: paste these as Environment Variables in the dashboard

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/trinayhospital?retryWrites=true&w=majority

# JWT Secrets — generate random strings at: https://generate-secret.now.sh/64
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_64_CHARS
STAFF_JWT_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET_64_CHARS

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Port (Render sets this automatically — do NOT change for Render)
PORT=5000

# Node environment
NODE_ENV=production
