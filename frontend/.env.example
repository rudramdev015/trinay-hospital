# ── TRINAY HOSPITAL FRONTEND — Environment Variables ─────────────────────────
# LOCAL DEVELOPMENT: copy this file to .env and fill in values
# VERCEL PRODUCTION: add in Vercel Dashboard → Project → Settings → Environment Variables

# Your Render backend URL — get this AFTER deploying backend to Render.com
# Example: https://trinay-hospital-api.onrender.com
VITE_API_URL=https://YOUR-BACKEND-NAME.onrender.com

# Leave blank for local dev (Vite proxy handles /api → localhost:5000)
# VITE_API_URL=
